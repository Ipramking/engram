# ─────────────────────────────────────────────────────────────
# Engram — environment
# Copy to `.env` and fill in. With NO memwal creds set, the app
# runs against the offline MemWalMock so you can build/demo the UI
# with zero setup. Fill these in to store on the real Walrus network.
# ─────────────────────────────────────────────────────────────

# LLM via Groq (fast open-weight models; switch between them to prove memory is
# portable across models). Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
# Default model; any Groq model id works (openai/gpt-oss-20b, qwen/qwen3.8-27b…).
ENGRAM_MODEL=openai/gpt-oss-20b

# ── Walrus Memory (personal scope) ──────────────────────────
# Generate an account id + delegate key at https://memory.walrus.xyz
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
# Production (mainnet): https://relayer.memory.walrus.xyz
# Staging  (testnet):   https://relayer-staging.memory.walrus.xyz
MEMWAL_SERVER_URL=https://relayer-staging.memory.walrus.xyz

# ── Walrus Memory (team scope) ──────────────────────────────
# A SECOND shared account whose creds you hand teammates via a join code.
# All teammates configuring these read/write the same verifiable pool.
# If left blank, team scope falls back to the personal account with a
# separate namespace (still isolated, but not cross-user shared).
TEAM_MEMWAL_PRIVATE_KEY=
TEAM_MEMWAL_ACCOUNT_ID=

# Force the offline mock even if creds are present (handy for demos).
ENGRAM_USE_MOCK=
