{
  "//": "Type settings for the Vercel serverless functions. Vercel uses the tsconfig nearest each function.",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true
  },
  "include": ["./**/*.ts"]
}
