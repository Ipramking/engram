{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/api/health",
      "destination": "/api/auth?subpath=health"
    },
    {
      "source": "/api/storage",
      "destination": "/api/memories?subpath=storage"
    },
    {
      "source": "/api/storage/:path*",
      "destination": "/api/memories?subpath=storage"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth?subpath=:path*"
    },
    {
      "source": "/api/keys/:path*",
      "destination": "/api/keys?subpath=:path*"
    },
    {
      "source": "/api/teams/:path*",
      "destination": "/api/teams?subpath=:path*"
    },
    {
      "source": "/api/usage/:path*",
      "destination": "/api/usage?subpath=:path*"
    },
    {
      "source": "/api/memories/:path*",
      "destination": "/api/memories?subpath=:path*"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/connect?subpath=prm"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "/api/connect?subpath=prm"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/connect?subpath=asm"
    },
    {
      "source": "/.well-known/oauth-authorization-server/:path*",
      "destination": "/api/connect?subpath=asm"
    },
    {
      "source": "/.well-known/openid-configuration",
      "destination": "/api/connect?subpath=asm"
    },
    {
      "source": "/oauth/register",
      "destination": "/api/connect?subpath=register"
    },
    {
      "source": "/oauth/token",
      "destination": "/api/connect?subpath=token"
    },
    {
      "source": "/api/telegram",
      "destination": "/api/connect?subpath=telegram"
    },
    {
      "source": "/api/connect/:path*",
      "destination": "/api/connect?subpath=:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
